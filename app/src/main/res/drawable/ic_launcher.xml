<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive launcher icon. Lives in drawable/ rather than mipmap-anydpi-v26
    because minSdk is 26: every supported device understands adaptive icons, so
    no bitmap fallback is needed and the redundant -v26 qualifier would only
    invite lint noise.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
