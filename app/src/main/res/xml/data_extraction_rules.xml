<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only the database and DataStore leave the device. Reports and safety
         snapshots stay local: they are derived data and may contain receipts. -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
